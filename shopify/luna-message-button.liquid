{%- comment -%}
  Luna Message Button: a small "Message me" pill in the corner of every page, linking to the Contact page.
  Add it once in the theme editor: Footer > Add section > Luna Message Button. It then shows on every page.
{%- endcomment -%}
{%- assign lmb_link = section.settings.link | default: '/pages/contact' -%}
{%- assign lmb_here = false -%}
{%- if request.path == lmb_link -%}{%- assign lmb_here = true -%}{%- endif -%}
{%- unless lmb_here -%}
<a href="{{ lmb_link }}" class="lmb{% if template.name == 'product' %} lmb--product{% endif %}" aria-label="Message Lilac Desk">
  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/></svg>
  <span>{{ section.settings.label }}</span>
</a>
<style>
  .lmb {
    position: fixed; right: 18px; bottom: 18px; z-index: 40;
    display: inline-flex; align-items: center; gap: 8px;
    padding: 11px 18px 11px 15px; border-radius: 999px;
    background: #333333; color: #FAFAF8; text-decoration: none;
    font-family: 'Jost', sans-serif; font-weight: 400; font-size: 13.5px; letter-spacing: .02em; line-height: 1;
    box-shadow: 0 10px 28px -12px rgba(51, 51, 51, .55);
    transition: background .15s, transform .15s;
  }
  .lmb:hover { background: #5C181E; color: #FAFAF8; transform: translateY(-1px); }
  .lmb:focus-visible { outline: 2px solid #5C181E; outline-offset: 3px; }
  @media (max-width: 749px) {
    .lmb { right: 14px; bottom: 14px; padding: 12px; }
    .lmb span { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    /* keep clear of the sticky add-to-cart bar on product pages */
    .lmb--product { bottom: 84px; }
  }
  @media print { .lmb { display: none; } }
</style>
{%- endunless -%}

{% schema %}
{
  "name": "Luna Message Button",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "text", "id": "label", "label": "Button text", "default": "Message me" },
    { "type": "text", "id": "link", "label": "Contact page address", "default": "/pages/contact" }
  ],
  "presets": [{ "name": "Luna Message Button" }]
}
{% endschema %}
