{%- comment -%}
  Luna Custom Planner Feature: promotes custom planners on the home page.
  Photo on one side, headline, personal and commercial options, and a button.
  Everything is editable in the theme editor.
{%- endcomment -%}
{%- assign sid = section.id -%}

<style>
  #lcp-{{ sid }} { background: #FAFAF8; color: #333333; border-bottom: 1px solid #D5D2CC; }
  #lcp-{{ sid }}, #lcp-{{ sid }} * { box-sizing: border-box; }
  #lcp-{{ sid }} p { margin: 0; }
  #lcp-{{ sid }} .lcp-in { max-width: 1300px; margin: 0 auto; padding: 60px 4.5%; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px; align-items: center; }
  #lcp-{{ sid }}.lcp--right .lcp-in { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); }
  #lcp-{{ sid }}.lcp--right .lcp-media { order: 2; }
  #lcp-{{ sid }} .lcp-media { position: relative; aspect-ratio: 4 / 3; border: 1px solid #D5D2CC; overflow: hidden; background: #FAFAF8; }
  #lcp-{{ sid }} .lcp-media img, #lcp-{{ sid }} .lcp-media svg { width: 100%; height: 100%; object-fit: cover; display: block; }
  #lcp-{{ sid }} .lcp-tag { position: absolute; left: 10px; top: 10px; background: #FAFAF8; color: #5C181E; padding: 5px 9px; font-family: 'Jost', sans-serif; font-size: 9px; font-weight: 500; letter-spacing: 2px; text-transform: uppercase; }
  #lcp-{{ sid }} .lcp-body { max-width: 560px; }
  #lcp-{{ sid }} .lcp-micro { display: block; font-family: 'Jost', sans-serif; font-size: 9px; font-weight: 500; letter-spacing: 2.5px; color: #5C181E; text-transform: uppercase; margin-bottom: 12px; }
  #lcp-{{ sid }} .lcp-heading { font-family: 'Times New Roman', Times, serif; font-size: 14px; font-weight: 400; letter-spacing: 2px; color: #333333; text-transform: uppercase; line-height: 1.35; margin: 0 0 14px; }
  #lcp-{{ sid }} .lcp-desc { font-family: 'Jost', sans-serif; font-size: 11px; font-weight: 400; line-height: 1.65; letter-spacing: 0.1px; color: #666666; margin: 0 0 18px; }
  #lcp-{{ sid }} .lcp-opts { border-top: 1px solid #D5D2CC; margin-bottom: 24px; }
  #lcp-{{ sid }} .lcp-opt { display: grid; grid-template-columns: 130px 1fr auto; gap: 14px; align-items: baseline; padding: 10px 0; border-bottom: 1px solid #D5D2CC; text-decoration: none; color: #333333; }
  #lcp-{{ sid }} .lcp-opt small { font-family: 'Jost', sans-serif; font-size: 9px; font-weight: 500; letter-spacing: 2px; text-transform: uppercase; color: #333333; }
  #lcp-{{ sid }} .lcp-opt small em { font-style: normal; color: #5C181E; margin-right: 4px; }
  #lcp-{{ sid }} .lcp-opt span { font-family: 'Jost', sans-serif; font-size: 11px; line-height: 1.6; color: #666666; transition: color .2s ease; }
  #lcp-{{ sid }} a.lcp-opt:hover span { color: #333333; }
  #lcp-{{ sid }} .lcp-opt b { font-family: 'Jost', sans-serif; font-size: 9px; font-weight: 500; letter-spacing: 0.5px; color: #333333; white-space: nowrap; text-transform: uppercase; }
  #lcp-{{ sid }} .lcp-acts { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
  #lcp-{{ sid }} .lcp-btn, #lcp-{{ sid }} .lcp-link { display: inline-block; font-family: 'Jost', sans-serif; font-size: 10px; font-weight: 500; letter-spacing: 1.5px; text-transform: uppercase; text-decoration: none; padding-bottom: 2px; transition: opacity 0.2s ease; }
  #lcp-{{ sid }} .lcp-btn { color: #5C181E; border-bottom: 1px solid #5C181E; }
  #lcp-{{ sid }} .lcp-link { color: #333333; border-bottom: 1px solid #D5D2CC; }
  #lcp-{{ sid }} .lcp-btn:hover, #lcp-{{ sid }} .lcp-link:hover { opacity: 0.7; }
  @media (max-width: 768px) {
    #lcp-{{ sid }} .lcp-in, #lcp-{{ sid }}.lcp--right .lcp-in { grid-template-columns: 1fr; gap: 28px; padding: 50px 20px; }
    #lcp-{{ sid }}.lcp--right .lcp-media { order: 0; }
    #lcp-{{ sid }} .lcp-media { aspect-ratio: 16 / 10; }
    #lcp-{{ sid }} .lcp-opt { grid-template-columns: 1fr auto; gap: 2px 14px; }
    #lcp-{{ sid }} .lcp-opt small { grid-column: 1 / -1; }
  }
</style>

<section id="lcp-{{ sid }}" class="lcp{% if section.settings.image_side == 'right' %} lcp--right{% endif %}">
  <div class="lcp-in">
    <div class="lcp-media">
      {%- if section.settings.image != blank -%}
        {%- assign lcp_alt = section.settings.image.alt | default: 'A custom Lilac Desk planner' -%}
        {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1800', sizes: '(max-width: 800px) 100vw, 40vw', alt: lcp_alt }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
      {%- if section.settings.tag_bold != blank or section.settings.tag_text != blank -%}
        <p class="lcp-tag">{{ section.settings.tag_bold }}{% if section.settings.tag_bold != blank and section.settings.tag_text != blank %} · {% endif %}{{ section.settings.tag_text }}</p>
      {%- endif -%}
    </div>

    <div class="lcp-body">
      {%- if section.settings.micro_tag != blank -%}<span class="lcp-micro">// {{ section.settings.micro_tag }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="lcp-heading">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<p class="lcp-desc">{{ section.settings.text }}</p>{%- endif -%}

      <div class="lcp-opts">
        {%- for i in (1..2) -%}
          {%- if i == 1 -%}
            {%- assign o_title = section.settings.opt1_title -%}{%- assign o_text = section.settings.opt1_text -%}{%- assign o_price = section.settings.opt1_price -%}{%- assign o_link = section.settings.opt1_link -%}
          {%- else -%}
            {%- assign o_title = section.settings.opt2_title -%}{%- assign o_text = section.settings.opt2_text -%}{%- assign o_price = section.settings.opt2_price -%}{%- assign o_link = section.settings.opt2_link -%}
          {%- endif -%}
          {%- if o_title != blank -%}
            {%- if o_link != blank -%}<a class="lcp-opt" href="{{ o_link }}">{%- else -%}<div class="lcp-opt">{%- endif -%}
              <small><em>0{{ i }} //</em>{{ o_title }}</small>
              <span>{{ o_text }}</span>
              {%- if o_price != blank -%}<b>From {{ o_price }}</b>{%- endif -%}
            {%- if o_link != blank -%}</a>{%- else -%}</div>{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="lcp-acts">
        {%- if section.settings.button_label != blank -%}<a class="lcp-btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>{%- endif -%}
        {%- if section.settings.link_label != blank -%}<a class="lcp-link" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>

</section>

{% schema %}
{
  "name": "Luna Custom Planners",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Photo side",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "text",
      "id": "tag_bold",
      "label": "Photo tag",
      "default": "Now open"
    },
    {
      "type": "text",
      "id": "tag_text",
      "label": "Photo tag, second part (optional)"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "micro_tag",
      "label": "Micro tagline (after //)",
      "default": "MADE TO ORDER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "CUSTOM PLANNERS, NOW OPEN"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Paragraph",
      "default": "Tell me how you plan, and I'll design your planner around it: your pages, your layout, your colors, tabless or tabbed."
    },
    {
      "type": "header",
      "content": "Personal"
    },
    {
      "type": "text",
      "id": "opt1_title",
      "label": "Label",
      "default": "Personal"
    },
    {
      "type": "text",
      "id": "opt1_text",
      "label": "Description",
      "default": "For you, or a gift for someone you love."
    },
    {
      "type": "text",
      "id": "opt1_price",
      "label": "Starting price",
      "default": "$30"
    },
    {
      "type": "text",
      "id": "opt1_link",
      "label": "Link",
      "default": "/pages/custom-planners"
    },
    {
      "type": "header",
      "content": "Commercial"
    },
    {
      "type": "text",
      "id": "opt2_title",
      "label": "Label",
      "default": "Commercial"
    },
    {
      "type": "text",
      "id": "opt2_text",
      "label": "Description",
      "default": "Designed exclusively for you to sell or share with clients."
    },
    {
      "type": "text",
      "id": "opt2_price",
      "label": "Starting price",
      "default": "$60"
    },
    {
      "type": "text",
      "id": "opt2_link",
      "label": "Link",
      "default": "/pages/custom-planners"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "DESIGN YOUR PLANNER"
    },
    {
      "type": "text",
      "id": "button_link",
      "label": "Button link",
      "default": "/pages/custom-planners"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Second link label",
      "default": "ASK ABOUT A CUSTOM QUOTE"
    },
    {
      "type": "text",
      "id": "link_url",
      "label": "Second link",
      "default": "/pages/contact"
    }
  ],
  "presets": [
    {
      "name": "Luna Custom Planners"
    }
  ]
}
{% endschema %}
