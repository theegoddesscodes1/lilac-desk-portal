{%- comment -%}
  Luna Custom Planners (home page). Built on the same layout and styles as the Luna Resource Showcase:
  a small text panel on the left, up to three cards on the right (personal, commercial, fully custom).
{%- endcomment -%}
<div class="luna-cpf-section">
  <div class="luna-cpf-grid">

    <div class="luna-cpf-text-panel">
      <div class="luna-cpf-inner-contain">
        {%- if section.settings.micro_tag != blank -%}
          <span class="luna-cpf-micro-tag">// {{ section.settings.micro_tag | upcase }}</span>
        {%- endif -%}
        {%- if section.settings.heading_text != blank -%}
          <h2 class="luna-cpf-heading">{{ section.settings.heading_text | upcase }}</h2>
        {%- endif -%}
        {%- if section.settings.desc_text != blank -%}
          <p class="luna-cpf-desc">{{ section.settings.desc_text }}</p>
        {%- endif -%}
        {%- if section.settings.btn_label != blank -%}
          <a href="{{ section.settings.btn_link | default: '/pages/custom-planners' }}" class="luna-cpf-inline-btn">{{ section.settings.btn_label | upcase }}</a>
        {%- endif -%}
      </div>
    </div>

    <div class="luna-cpf-gallery-panel">
      <div class="luna-cpf-matrix">
        {%- for block in section.blocks -%}
          <div class="luna-cpf-item" {{ block.shopify_attributes }}>
            <a href="{{ block.settings.link | default: '/pages/custom-planners' }}" class="luna-cpf-anchor">
              <div class="luna-cpf-viewport">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
                {%- else -%}
                  <div class="luna-cpf-empty">{{ 'product-apparel-' | append: forloop.index | placeholder_svg_tag }}</div>
                {%- endif -%}
                {%- if block.settings.badge != blank -%}<span class="luna-cpf-badge">{{ block.settings.badge | upcase }}</span>{%- endif -%}
              </div>
              <div class="luna-cpf-meta-lines">
                <span class="luna-cpf-title">{{ block.settings.title | upcase }}</span>
                <span class="luna-cpf-price">{{ block.settings.price }}</span>
              </div>
              {%- if block.settings.note != blank -%}<span class="luna-cpf-note">{{ block.settings.note }}</span>{%- endif -%}
            </a>
          </div>
        {%- endfor -%}
      </div>
    </div>

  </div>
</div>

{% style %}
.luna-cpf-section, .luna-cpf-section * {
  box-sizing: border-box !important;
  margin: 0;
  padding: 0;
}
.luna-cpf-section {
  width: 100% !important;
  max-width: 100% !important;
  background-color: #FAFAF8 !important;
  padding: 60px 4.5% !important;
  overflow: hidden;
  border-bottom: 1px solid #D5D2CC;
  display: block !important;
}
.luna-cpf-grid {
  display: grid !important;
  grid-template-columns: 0.8fr 1.2fr !important;
  align-items: center !important;
  gap: 48px !important;
  max-width: 1300px !important;
  margin: 0 auto !important;
  height: auto !important;
}
.luna-cpf-text-panel { display: flex !important; justify-content: flex-start !important; }
.luna-cpf-inner-contain { width: 100% !important; max-width: 360px !important; }
.luna-cpf-micro-tag {
  font-family: 'Jost', sans-serif !important;
  font-size: 9px !important;
  font-weight: 500 !important;
  letter-spacing: 2.5px !important;
  color: #5C181E !important;
  display: block !important;
  margin-bottom: 12px !important;
}
.luna-cpf-heading {
  font-family: 'Times New Roman', Times, serif !important;
  font-size: 14px !important;
  font-weight: 400 !important;
  letter-spacing: 2px !important;
  color: #333333 !important;
  margin: 0 0 14px 0 !important;
  line-height: 1.35 !important;
}
.luna-cpf-desc {
  font-family: 'Jost', sans-serif !important;
  font-size: 11px !important;
  font-weight: 400 !important;
  line-height: 1.65 !important;
  color: #666666 !important;
  margin: 0 0 24px 0 !important;
  letter-spacing: 0.1px !important;
}
.luna-cpf-inline-btn {
  display: inline-block !important;
  color: #5C181E !important;
  font-family: 'Jost', sans-serif !important;
  font-size: 10px !important;
  font-weight: 500 !important;
  letter-spacing: 1.5px !important;
  text-decoration: none !important;
  text-transform: uppercase !important;
  border-bottom: 1px solid #5C181E !important;
  padding-bottom: 2px !important;
  transition: opacity 0.2s ease !important;
}
.luna-cpf-inline-btn:hover { opacity: 0.7 !important; }

.luna-cpf-gallery-panel { width: 100% !important; display: flex !important; align-items: center !important; }
.luna-cpf-matrix {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: nowrap !important;
  gap: 16px !important;
  width: 100% !important;
  justify-content: flex-start !important;
  align-items: flex-start !important;
}
.luna-cpf-item {
  flex: 1 1 0% !important;
  min-width: 0 !important;
  max-width: calc(33.333% - 11px) !important;
  display: flex !important;
  flex-direction: column !important;
}
.luna-cpf-anchor {
  text-decoration: none !important;
  color: #333333 !important;
  display: flex !important;
  flex-direction: column !important;
  width: 100% !important;
}
.luna-cpf-viewport {
  width: 100% !important;
  aspect-ratio: 3 / 4 !important;
  overflow: hidden !important;
  border: 1px solid #D5D2CC !important;
  background-color: #FAFAF8 !important;
  position: relative !important;
  margin-bottom: 8px !important;
}
.luna-cpf-viewport img, .luna-cpf-empty svg {
  width: 100% !important;
  height: 100% !important;
  object-fit: cover !important;
  display: block !important;
  transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1) !important;
}
.luna-cpf-empty svg { fill: #fafafa !important; background-color: #fcfcfc !important; }
.luna-cpf-anchor:hover .luna-cpf-viewport img { transform: scale(1.03) !important; }
.luna-cpf-badge {
  position: absolute !important;
  left: 8px !important;
  top: 8px !important;
  background: #FAFAF8 !important;
  color: #5C181E !important;
  font-family: 'Jost', sans-serif !important;
  font-size: 8px !important;
  font-weight: 500 !important;
  letter-spacing: 1.5px !important;
  padding: 4px 7px !important;
}
.luna-cpf-meta-lines {
  display: flex !important;
  justify-content: space-between !important;
  align-items: center !important;
  width: 100% !important;
  padding: 4px 0 0 0 !important;
}
.luna-cpf-title {
  font-family: 'Jost', sans-serif !important;
  font-size: 9px !important;
  font-weight: 400 !important;
  letter-spacing: 1px !important;
  color: #333333 !important;
  white-space: nowrap !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
  max-width: 75% !important;
}
.luna-cpf-price {
  font-family: 'Jost', sans-serif !important;
  font-size: 9px !important;
  font-weight: 500 !important;
  color: #333333 !important;
  letter-spacing: 0.5px !important;
  white-space: nowrap !important;
}
.luna-cpf-note {
  display: block !important;
  font-family: 'Jost', sans-serif !important;
  font-size: 9px !important;
  font-weight: 400 !important;
  line-height: 1.5 !important;
  color: #666666 !important;
  margin-top: 3px !important;
}

@media (max-width: 768px) {
  .luna-cpf-section { padding: 50px 0 50px 20px !important; }
  .luna-cpf-grid { grid-template-columns: 1fr !important; gap: 32px !important; }
  .luna-cpf-gallery-panel { min-width: 0 !important; }
  .luna-cpf-text-panel { justify-content: flex-start !important; text-align: left !important; padding-right: 20px !important; }
  .luna-cpf-item { max-width: 100% !important; }
  .luna-cpf-matrix { overflow-x: auto !important; scrollbar-width: none !important; -webkit-overflow-scrolling: touch !important; padding-right: 20px !important; }
  .luna-cpf-matrix::-webkit-scrollbar { display: none !important; }
  .luna-cpf-item { flex: 0 0 175px !important; width: 175px !important; }
}
{% endstyle %}

{% schema %}
{
  "name": "Luna Custom Planners",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "micro_tag", "label": "Micro tagline", "default": "MADE TO ORDER" },
    { "type": "text", "id": "heading_text", "label": "Heading", "default": "CUSTOM PLANNERS, NOW OPEN" },
    { "type": "textarea", "id": "desc_text", "label": "Description", "default": "Tell me how you plan, and I'll design your planner around it: your pages, your layout, your colors, tabless or tabbed. For yourself, or to sell and share with your clients." },
    { "type": "text", "id": "btn_label", "label": "Link text", "default": "DESIGN YOUR PLANNER" },
    { "type": "text", "id": "btn_link", "label": "Link", "default": "/pages/custom-planners" }
  ],
  "blocks": [
    {
      "type": "option",
      "name": "Planner card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "badge", "label": "Badge (optional)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Personal planner" },
        { "type": "text", "id": "price", "label": "Price text", "default": "From $30" },
        { "type": "text", "id": "note", "label": "Short line (optional)" },
        { "type": "text", "id": "link", "label": "Link", "default": "/pages/custom-planners" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luna Custom Planners",
      "blocks": [
        { "type": "option", "settings": { "title": "Personal planner", "price": "From $30", "note": "For you, or a gift." } },
        { "type": "option", "settings": { "title": "Commercial planner", "price": "From $60", "note": "Yours to sell or share with clients." } },
        { "type": "option", "settings": { "title": "Fully custom", "price": "Quote", "note": "Something beyond the tiers? Ask me.", "link": "/pages/contact" } }
      ]
    }
  ]
}
{% endschema %}
