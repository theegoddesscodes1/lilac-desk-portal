{%- comment -%}
  Luna Reviews: shows the reviews you switched on ("Show on the shop") in your order portal.
  Paste your Supabase anon (public) key in the section settings once. It's the same public key the portal uses.
{%- endcomment -%}
{%- assign sid = section.id -%}
{%- assign lrv_base = section.settings.supabase_url | default: 'https://fdxbqdhzzyyggdtbjwnz.supabase.co' | strip -%}

<style>
  #lrv-{{ sid }} {
    --c: #333333; --w: #FAFAF8; --l: #D6D0DE; --o: #5C181E; --g: #D5D2CC;
    --serif: 'Times New Roman', Times, serif; --sans: 'Jost', sans-serif;
    background: var(--w); color: var(--c); font-family: var(--sans); font-weight: 300;
    padding: clamp(44px, 6vw, 72px) 16px;
  }
  #lrv-{{ sid }} *, #lrv-{{ sid }} *::before, #lrv-{{ sid }} *::after { box-sizing: border-box; }
  #lrv-{{ sid }} p { margin: 0; }
  #lrv-{{ sid }} .lrv-wrap { max-width: 1040px; margin: 0 auto; }
  #lrv-{{ sid }} .lrv-head { text-align: center; margin-bottom: 34px; }
  #lrv-{{ sid }} .lrv-eyebrow { font-size: 10.5px; letter-spacing: .22em; text-transform: uppercase; color: var(--o); margin-bottom: 10px; }
  #lrv-{{ sid }} h2 { font-family: var(--serif); font-weight: 400; font-size: clamp(20px, 2vw, 24px); line-height: 1.3; margin: 0 0 10px; letter-spacing: 0; text-transform: none; color: var(--c); }
  #lrv-{{ sid }} .lrv-avg { display: inline-flex; align-items: center; gap: 8px; font-size: 12.5px; letter-spacing: .04em; color: #6c6862; }
  #lrv-{{ sid }} .lrv-avg .lrv-stars { font-size: 12px; }
  #lrv-{{ sid }} .lrv-grid { display: flex; justify-content: center; gap: 0; width: fit-content; max-width: 100%; margin: 0 auto; border-top: 1px solid var(--g); border-bottom: 1px solid var(--g); }
  #lrv-{{ sid }} .lrv-card { flex: 0 1 340px; min-width: 0; padding: 30px 30px 26px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 14px; }
  #lrv-{{ sid }} .lrv-card + .lrv-card { border-left: 1px solid var(--g); }
  #lrv-{{ sid }} .lrv-stars { color: var(--o); letter-spacing: 3px; font-size: 11px; }
  #lrv-{{ sid }} .lrv-stars span { color: var(--g); }
  #lrv-{{ sid }} .lrv-body { font-family: var(--serif); font-style: italic; font-size: 16px; line-height: 1.6; color: #3d3b38; }
  #lrv-{{ sid }} .lrv-photo { width: 84px; height: 84px; object-fit: cover; border-radius: 50%; display: block; }
  #lrv-{{ sid }} .lrv-who { margin-top: auto; font-size: 10.5px; letter-spacing: .18em; text-transform: uppercase; color: var(--c); }
  #lrv-{{ sid }} .lrv-who span { display: block; margin-top: 4px; letter-spacing: .06em; text-transform: none; font-size: 12px; color: #8a867f; }
  #lrv-{{ sid }} .lrv-status { margin-top: 14px; padding: 14px 16px; border: 1px dashed var(--g); border-radius: 14px; font-size: 13.5px; color: #6c6862; text-align: center; }
  @media (max-width: 800px) {
    #lrv-{{ sid }} .lrv-grid { width: auto; justify-content: flex-start; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
    #lrv-{{ sid }} .lrv-grid::-webkit-scrollbar { display: none; }
    #lrv-{{ sid }} .lrv-card { flex: 0 0 82%; scroll-snap-align: center; padding: 26px 22px; }
    #lrv-{{ sid }} .lrv-grid:has(.lrv-card:only-child) { justify-content: center; }
    #lrv-{{ sid }} .lrv-grid:has(.lrv-card:only-child) .lrv-card { flex-basis: 100%; }
  }
</style>

<section id="lrv-{{ sid }}"{% unless request.design_mode %} hidden{% endunless %}>
  <div class="lrv-wrap">
    <div class="lrv-head">
      <p class="lrv-eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p class="lrv-avg"></p>
    </div>
    <div class="lrv-grid"></div>
    {%- if request.design_mode -%}
      <p class="lrv-status">Checking for reviews…</p>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('lrv-{{ sid }}');
    var base = {{ lrv_base | json }}.replace(/\/+$/, '');
    var key = {{ section.settings.anon_key | strip | json }};
    var limit = {{ section.settings.limit | default: 6 }};
    var status = root ? root.querySelector('.lrv-status') : null;
    var say = function (t) { if (status) status.textContent = t; };
    if (!root) return;
    if (!key) return say('Paste your Supabase anon public key in this section’s settings.');
    var esc = function (s) { return String(s || '').replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
    fetch(base + '/rest/v1/rpc/featured_reviews', {
      method: 'POST',
      headers: { apikey: key, Authorization: 'Bearer ' + key, 'Content-Type': 'application/json' },
      body: '{}'
    })
      .then(function (r) {
        if (!r.ok) return r.text().then(function (t) { say('Couldn’t load reviews (' + r.status + '). ' + (r.status === 404 ? 'Run the reviews SQL file in Supabase first.' : r.status === 401 ? 'Check the anon key.' : t.slice(0, 160))); return null; });
        return r.json();
      })
      .then(function (rows) {
        if (!rows) return;
        if (!rows.length) return say('No reviews switched on yet. In your portal, open Reviews and turn on “Show on the shop” for the ones you want here. (Only you see this message, in the theme editor.)');
        if (status) status.remove();
        var avg = rows.reduce(function (n, r) { return n + r.rating; }, 0) / rows.length;
        var full = Math.round(avg);
        root.querySelector('.lrv-avg').innerHTML = '<span class="lrv-stars">' + '★★★★★'.slice(0, full) + '<span>' + '★★★★★'.slice(full) + '</span></span>' + avg.toFixed(1) + ' from ' + rows.length + ' ' + (rows.length === 1 ? 'review' : 'reviews');
        root.querySelector('.lrv-grid').innerHTML = rows.slice(0, limit).map(function (r) {
          var stars = '★★★★★'.slice(0, r.rating) + '<span>' + '★★★★★'.slice(r.rating) + '</span>';
          var photo = r.photo_path ? '<img class="lrv-photo" loading="lazy" alt="" src="' + base + '/storage/v1/object/public/review-photos/' + esc(r.photo_path) + '">' : '';
          var words = r.body ? '<p class="lrv-body">“' + esc(r.body) + '”</p>' : '';
          return '<article class="lrv-card">' + photo + '<p class="lrv-stars" aria-label="' + r.rating + ' out of 5">' + stars + '</p>' +
            words +
            '<p class="lrv-who"><b>' + esc(r.name || 'A Lilac Desk customer') + '</b><span>' + esc(r.planner || 'Custom planner') + '</span></p></article>';
        }).join('');
        root.hidden = false;
      })
      .catch(function (e) { say('Couldn’t reach Supabase: ' + e.message); });
  })();
</script>

{% schema %}
{
  "name": "Luna Reviews",
  "settings": [
    { "type": "text", "id": "anon_key", "label": "Supabase anon public key", "info": "Supabase > Project Settings > API > anon public key" },
    { "type": "text", "id": "supabase_url", "label": "Supabase project URL", "default": "https://fdxbqdhzzyyggdtbjwnz.supabase.co" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Kind words" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the people who plan with them" },
    { "type": "range", "id": "limit", "label": "Reviews to show", "min": 3, "max": 12, "step": 3, "default": 6 }
  ],
  "presets": [{ "name": "Luna Reviews" }]
}
{% endschema %}
